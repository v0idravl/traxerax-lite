# Template unit — the recommended install is `sudo traxerax-lite --setup`,
# which renders a unit with the correct paths for this machine and enables it.
[Unit]
Description=traxerax-lite host defense and audit daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/traxerax-lite
ExecStart=/opt/traxerax-lite/venv/bin/python -m traxerax_lite.main --daemon --config /opt/traxerax-lite/config/default.yaml
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

# Root is required to attach the eBPF probe. Many checks still work when run as
# a non-root user with sufficient read permissions.
User=root
Group=root

# Sandboxing compatible with eBPF loading (mirrors falco-modern-bpf.service).
# No SystemCallFilter: restrictive filters omit bpf()/perf_event_open and
# would break probe attachment.
UMask=0077
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The tool makes no network calls; only local sockets are permitted.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
